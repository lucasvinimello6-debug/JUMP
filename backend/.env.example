# Backend JUMP - Variáveis de Ambiente

# Firebase Config
FIREBASE_PROJECT_ID=jump-saas-prod
FIREBASE_PRIVATE_KEY=your_private_key_here
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@jump-saas-prod.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://jump-saas-prod.firebaseio.com

# Twilio Config
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_NUMBER=+55119999999999

# Stripe Config
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_PUBLIC_KEY=pk_live_your_key

# Server Config
NODE_ENV=production
PORT=3000
API_URL=https://api.jump.com

# JWT Config
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Service (SendGrid optional)
SENDGRID_API_KEY=your_sendgrid_key
